# Copy to .env and set PGPASSWORD. .env is git-ignored.
# Use the raw password here (no percent-encoding needed; it is passed as PGPASSWORD, not in a URL).
# Supabase session pooler (IPv4). The direct host db.nrhsoabqeskybrznxfyi.supabase.co is IPv6-only;
# use it (with PGUSER=postgres) only if your network has IPv6.
PGHOST=aws-0-us-east-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.nrhsoabqeskybrznxfyi
PGPASSWORD=
PGSSLMODE=require

# Optional: folder holding pg_dump/psql whose major version >= the server's (Supabase runs 15/17).
# e.g. after `brew install libpq`: /opt/homebrew/opt/libpq/bin
PG_BIN=/opt/homebrew/opt/libpq/bin
