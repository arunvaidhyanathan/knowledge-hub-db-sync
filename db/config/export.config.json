{
  "version": 1,
  "schemas": [
    "public",
    "cads"
  ],
  "excludeTablePatterns": [],
  "extensions": [],
  "piiColumnPattern": "(?i)(email|phone|mobile|ssn|tax_?id|dob|birth|address|account_?(no|num)|card|salary|passport)",
  "limits": {
    "maxRowsPerTable": 50000,
    "maxBytesPerFile": 10485760
  },
  "master": [
    { "table": "cads.continents", "orderBy": ["continent_id"], "classification": "reference" },
    { "table": "cads.regions", "orderBy": ["region_id"], "classification": "reference" },
    { "table": "cads.countries", "orderBy": ["country_id"], "classification": "reference" }
  ],
  "tsOutput": "frontend/src/generated/master-data.ts"
}
